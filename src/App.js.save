                  </div>
                  <div className="project-card-mini">
                    <h4>Веб-сайт</h4>
                    <p>Адаптивный дизайн</p>
                  </div>
                </>
              )}
            </div>
          </div>
          
          <div className="section">
            <h3>Статистика</h3>
            <div className="stats-grid">
              <div className="stat-item">
                <div className="stat-number">{siteData.projects?.length || 0}</div>
                <div className="stat-label">Проектов</div>
              </div>
              <div className="stat-item">
                <div className="stat-number">{siteData.skills?.length || 0}</div>
                <div className="stat-label">Навыков</div>
              </div>
              <div className="stat-item">
                <div className="stat-number">1+</div>
                <div className="stat-label">Года опыта</div>
              </div>
              <div className="stat-item">
                <div className="stat-number">ватис</div>
                <div className="stat-label">лох</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
};

// Компонент страницы галереи
const GalleryPage = ({ siteData, onItemClick }) => {
  return (
    <div className="page gallery-page">
      <div className="page-content">
        <h2 className="page-title">Галерея</h2>
        <div className="gallery-content">
          {siteData.gallery && siteData.gallery.length > 0 ? (
            <div className="gallery-grid">
              {siteData.gallery.map((item, index) => (
                <div 
                  key={index} 
                  className="gallery-item clickable-gallery-item"
                  onClick={() => onItemClick(item)}
                  title="Нажмите для просмотра в полном размере"
                >
                  {item.type === 'image' ? (
                    <img 
                      src={item.url} 
                      alt={item.title || `Изображение ${index + 1}`}
                      className="gallery-image"
                    />
                  ) : (
                    <video 
                      src={item.url} 
                      controls 
                      className="gallery-video"
                    >
                      Ваш браузер не поддерживает видео.
                    </video>
                  )}
                  <div className="gallery-overlay">
                    <h4>{item.title || `Медиа ${index + 1}`}</h4>
                    {item.description && <p>{item.description}</p>}
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <div className="empty-gallery">
              <div className="empty-icon">🖼️</div>
              <h3>Галерея пуста</h3>
              <p>Здесь будут отображаться ваши фотографии и видео</p>
            </div>
          )}
        </div>
      </div>
    </div>
  );
};

// Компонент страницы "О себе"
const AboutPage = ({ siteData }) => {
  return (
    <div className="page about-page">
      <div className="page-content">
        <h2 className="page-title">О себе</h2>
        <div className="about-content">
          <div className="about-text">
            {siteData.aboutText?.map((paragraph, index) => (
              <p key={index}>{paragraph}</p>
            )) || (
              <>
                <p>
                  Привет! Меня зовут {siteData.name}, и я увлеченный разработчик с страстью к созданию 
                  инновационных веб-приложений. Моя цель - создавать не только функциональные, 
                  но и красивые решения, которые приносят пользу пользователям.
                </p>
                <p>
                  Я специализируюсь на современных технологиях веб-разработки и постоянно 
                  изучаю новые инструменты и подходы для улучшения качества моих проектов.
                </p>
              </>
            )}
          </div>
          <div className="skills-section">
            <h3>Навыки</h3>
            <div className="skills-grid">
              {siteData.skills.map((skill, index) => (
                <div key={index} className="skill-item">{skill}</div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  );
};

// Компонент страницы проектов
const ProjectsPage = ({ siteData }) => {
  const projects = siteData.projects;

  const handleProjectClick = (project) => {
    if (project.hasLink && project.url) {
      window.open(project.url, '_blank');
    }
  };

  return (
    <div className="page projects-page">
      <div className="page-content">
        <h2 className="page-title">Мои проекты</h2>
        <div className="projects-grid">
          {projects.map(project => (
            <div 
              key={project.id} 
              className={`project-card ${project.hasLink ? 'clickable-project' : ''}`}
              onClick={() => handleProjectClick(project)}
              style={{ cursor: project.hasLink ? 'pointer' : 'default' }}
            >
              <div className="project-header">
                <h3 className="project-title">{project.title}</h3>
                <span className={`project-status ${project.status.toLowerCase().replace(' ', '-')}`}>
                  {project.status}
                </span>
              </div>
              <p className="project-description">{project.description}</p>
              <div className="project-tech">
                {project.tech.map((tech, index) => (
                  <span key={index} className="tech-tag">{tech}</span>
                ))}
              </div>
              {project.hasLink && (
                <div className="project-link-hint">
                  <span className="link-icon">🔗</span>
                  <span>Нажми, чтобы открыть проект</span>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  );
};

// Компонент страницы контактов
const ContactPage = ({ onSubmitMessage, siteData }) => {
  const [formData, setFormData] = useState({
    name: '',
    email: '',
    message: ''
  });
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [submitStatus, setSubmitStatus] = useState('');

  const handleSubmit = async (e) => {
    e.preventDefault();
    setIsSubmitting(true);
    
    // Симуляция отправки
    setTimeout(() => {
      onSubmitMessage({
        title: 'Новое сообщение с сайта',
        message: `От: ${formData.name} (${formData.email})\n\nСообщение: ${formData.message}`,
        email: formData.email,
        type: 'contact'
      });
      
      setFormData({ name: '', email: '', message: '' });
      setSubmitStatus('success');
      setIsSubmitting(false);
      
      setTimeout(() => setSubmitStatus(''), 3000);
    }, 1000);
  };

  const handleChange = (e) => {
    setFormData({
      ...formData,
      [e.target.name]: e.target.value
    });
  };

  return (
    <div className="page contact-page">
      <div className="page-content">
        <h2 className="page-title">Связь со мной</h2>
        <div className="contact-content">
          <div className="contact-info">
            {(Array.isArray(siteData.contactInfo) ? siteData.contactInfo : []).map((contact, index) => (
              <div key={contact.id || index} className="contact-item">
                <div className="contact-icon">{contact.icon}</div>
                <div className="contact-details">
                  <h4>{contact.type}</h4>
                  <p>{contact.value}</p>
                </div>
              </div>
            ))}
            {(!siteData.contactInfo || !Array.isArray(siteData.contactInfo) || siteData.contactInfo.length === 0) && (
              <>
                <div className="contact-item">
                  <div className="contact-icon">📧</div>
                  <div className="contact-details">
                    <h4>Email</h4>
                    <p>syharik3316@example.com</p>
                  </div>
                </div>
                <div className="contact-item">
                  <div className="contact-icon">💬</div>
                  <div className="contact-details">
                    <h4>Telegram</h4>
                    <p>@syharik3316</p>
                  </div>
                </div>
                <div className="contact-item">
                  <div className="contact-icon">🐙</div>
                  <div className="contact-details">
                    <h4>GitHub</h4>
                    <p>github.com/syharik3316</p>
                  </div>
                </div>
              </>
            )}
          </div>
          <div className="contact-form">
            <h3>Написать мне</h3>
            <form onSubmit={handleSubmit}>
              <div className="form-group">
                <input 
                  type="text" 
                  name="name"
                  placeholder="Ваше имя" 
                  value={formData.name}
                  onChange={handleChange}
                  required
                />
              </div>
              <div className="form-group">
                <input 
                  type="email" 
                  name="email"
                  placeholder="Ваш email" 
                  value={formData.email}
                  onChange={handleChange}
                  required
                />
              </div>
              <div className="form-group">
                <textarea 
                  name="message"
                  placeholder="Сообщение" 
                  rows="5"
                  value={formData.message}
                  onChange={handleChange}
                  required
                ></textarea>
              </div>
              <button 
                type="submit" 
                className="btn btn-primary"
                disabled={isSubmitting}
              >
                {isSubmitting ? 'Отправка...' : 'Отправить'}
              </button>
              {submitStatus === 'success' && (
                <div className="success-message">
                  ✅ Сообщение отправлено! Я свяжусь с вами в ближайшее время.
                </div>
              )}
            </form>
          </div>
        </div>
      </div>
    </div>
  );
};

// Главный компонент приложения
function App() {
  const [currentPage, setCurrentPage] = useState('home');
  const [showGalleryModal, setShowGalleryModal] = useState(false);
  const [selectedGalleryItem, setSelectedGalleryItem] = useState(null);
  
  // Данные сайта
  const [siteData, setSiteData] = useState({
    name: 'syharik3316',
    title: 'Full Stack Developer',
    description: 'Разработчик, создающий удивительные веб-приложения',
    aboutText: [
      'Привет! Меня зовут syharik3316, и я увлеченный разработчик с страстью к созданию инновационных веб-приложений. Моя цель - создавать не только функциональные, но и красивые решения, которые приносят пользу пользователям.',
      'Я специализируюсь на современных технологиях веб-разработки и постоянно изучаю новые инструменты и подходы для улучшения качества моих проектов.'
    ],
    skills: ['React', 'JavaScript', 'CSS3', 'HTML5', 'Node.js', 'Git'],
    contactInfo: [
      { id: 1, type: 'Email', value: 'syharik3316@example.com', icon: '📧' },
      { id: 2, type: 'Telegram', value: '@syharik3316', icon: '💬' },
      { id: 3, type: 'GitHub', value: 'github.com/syharik3316', icon: '🐙' }
    ],
    projects: [
      {
        id: 1,
        title: "Веб-приложение",
        description: "Современное SPA приложение с красивым интерфейсом",
        tech: ["React", "CSS3", "JavaScript"],
        status: "Завершен",
        url: "https://example.com/project1",
        hasLink: true
      },
      {
        id: 2,
        title: "Портфолио сайт",
        description: "Персональный сайт-портфолио с анимациями",
        tech: ["React", "CSS3", "Анимации"],
        status: "В разработке",
        url: null,
        hasLink: false
      },
      {
        id: 3,
        title: "Мобильное приложение",
        description: "Кроссплатформенное мобильное приложение",
        tech: ["React Native", "JavaScript"],
        status: "Планируется",
        url: null,
        hasLink: false
      }
    ],
    gallery: [],
    backgroundImage: '',
    siteSettings: {
      siteName: 'syharik3316',
      menuItems: {
        home: 'Главная',
        about: 'О себе',
        projects: 'Проекты',
        gallery: 'Галерея',
        contact: 'Контакты'
      }
    }
  });

  // Загружаем данные из localStorage при инициализации
  useEffect(() => {
    const savedData = localStorage.getItem('siteData');
    if (savedData) {
      setSiteData(JSON.parse(savedData));
    }
  }, []);

  // Обработка отправки сообщений
  const handleSubmitMessage = (messageData) => {
    // В реальном приложении здесь был бы API запрос
    console.log('Новое сообщение:', messageData);
    // Уведомление будет добавлено в админ-панель через localStorage
    const notifications = JSON.parse(localStorage.getItem('adminNotifications') || '[]');
    const newNotification = {
      id: Date.now(),
      ...messageData,
      timestamp: new Date().toLocaleString('ru-RU'),
      read: false
    };
    localStorage.setItem('adminNotifications', JSON.stringify([newNotification, ...notifications]));
  };

  // Функции для работы с модальным окном галереи
  const openGalleryModal = (item) => {
    setSelectedGalleryItem(item);
    setShowGalleryModal(true);
  };

  const closeGalleryModal = () => {
    setShowGalleryModal(false);
    setSelectedGalleryItem(null);
  };

  const renderPage = () => {
    switch (currentPage) {
      case 'home':
        return <HomePage setCurrentPage={setCurrentPage} siteData={siteData} />;
      case 'about':
        return <AboutPage siteData={siteData} />;
      case 'projects':
        return <ProjectsPage siteData={siteData} />;
      case 'gallery':
        return <GalleryPage siteData={siteData} onItemClick={openGalleryModal} />;
      case 'contact':
        return <ContactPage onSubmitMessage={handleSubmitMessage} siteData={siteData} />;
      default:
        return <HomePage setCurrentPage={setCurrentPage} siteData={siteData} />;
    }
  };

  return (
    <div 
      className="App" 
      style={{
        backgroundImage: siteData.backgroundImage ? `url(${siteData.backgroundImage})` : undefined,
        backgroundSize: 'cover',
        backgroundPosition: 'center',
        backgroundAttachment: 'fixed'
      }}
    >
      <Navigation 
        currentPage={currentPage} 
        setCurrentPage={setCurrentPage}
        siteData={siteData}
      />
      <main className="main-content">
        {renderPage()}
      </main>

      {/* Модальное окно для просмотра галереи */}
      {showGalleryModal && selectedGalleryItem && (
        <div className="modal-overlay gallery-modal-overlay" onClick={closeGalleryModal}>
          <div className="gallery-modal-content" onClick={(e) => e.stopPropagation()}>
            <div className="gallery-modal-header">
              <h3>{selectedGalleryItem.title || 'Медиа'}</h3>
              <button className="close-btn" onClick={closeGalleryModal}>✕</button>
            </div>
            <div className="gallery-modal-body">
              {selectedGalleryItem.type === 'image' ? (
                <img 
                  src={selectedGalleryItem.url} 
                  alt={selectedGalleryItem.title || 'Изображение'}
                  className="full-size-gallery-media"
                />
              ) : (
                <video 
                  src={selectedGalleryItem.url} 
                  controls 
                  className="full-size-gallery-media"
                  autoPlay
                >
                  Ваш браузер не поддерживает видео.
                </video>
              )}
            </div>
            {selectedGalleryItem.description && (
              <div className="gallery-modal-footer">
                <p>{selectedGalleryItem.description}</p>
              </div>
            )}
          </div>
        </div>
      )}
    </div>
  );
}

export default App;
